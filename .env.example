# Copy to .env and fill in:  cp .env.example .env
# Avoid @ : / ? # in the camera password, they break RTSP URLs.

CAM_IP=10.1.0.40
CAM_USER=admin
CAM_PASS=change-me

# Your Mac's / PC's IP address (phones connect here for alerts). Mac: System Settings → Network
HOST_IP=10.1.0.X
# Alert channel name in the ntfy app (make it hard to guess)
NTFY_TOPIC=farm-alerts
# Where alerts are sent:
#   http://ntfy       = this computer only – phones get alerts on the site Wi-Fi only
#   https://ntfy.sh   = free public ntfy server – alerts reach phones anywhere (iPhone + Android).
#                       Use a long random NTFY_TOPIC with this, e.g. farm-k7q2m9x4w1
NTFY_SERVER=http://ntfy

# When to send "person seen" alerts: always | never | 18:00-07:00 (e.g. out of hours only)
PERSON_ALERT_HOURS=always

TZ=Europe/London
