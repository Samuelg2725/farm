# Copy to .env and fill in:  cp .env.example .env
# Avoid @ : / ? # in the camera password, they break RTSP URLs.

CAM_IP=10.1.0.40
CAM_USER=admin
CAM_PASS=change-me

# Your Mac's / PC's IP address (phones connect here for alerts). Mac: System Settings → Network
HOST_IP=10.1.0.X
# Phone alerts (ntfy app). Setup is shown on the dashboard → "Phone alerts" tab (QR code + test button).
#   NTFY_SERVER=https://ntfy.sh  → alerts reach phones anywhere (free public server). Leave NTFY_TOPIC
#                                  blank and a private random topic is created for you.
#   NTFY_SERVER=http://ntfy      → private, this computer only: phones must be on the farm Wi-Fi.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# Person alerts are switched on/off with the button on the dashboard.
# While ON, only alert during these hours: always, or e.g. 18:00-07:00 (out of hours only)
PERSON_ALERT_HOURS=always

TZ=Europe/London
