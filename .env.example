# Copy to .env and fill in:  cp .env.example .env
# Avoid @ : / ? # in the camera password, they break RTSP URLs.

CAM_IP=10.1.0.40
CAM_USER=admin
CAM_PASS=change-me

# This PC's IP address on the site network (phones connect here for alerts)
HOST_IP=10.1.0.X   # your Mac's IP – see README
# Alert channel name in the ntfy app (make it hard to guess)
NTFY_TOPIC=farm-alerts

# Optional: Telegram as well (free but not open source). Leave blank to skip.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TZ=Europe/London
