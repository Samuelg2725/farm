# Copy to .env and edit: cp .env.example .env
# Avoid the characters @ : / ? # in the camera password (they break RTSP URLs).

CAM_IP=10.1.0.40
CAM_USER=admin
CAM_PASS=change-me

# IP address of the host running the stack
HOST_IP=10.1.0.X

# Notifications (ntfy). See the "Phone alerts" tab on the dashboard for subscription details.
#   https://ntfy.sh  public server; leave NTFY_TOPIC empty to generate a private random topic
#   http://ntfy      bundled self-hosted server (clients must reach HOST_IP:8080)
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# Hours during which person alerts are sent while enabled: always, or a range such as 18:00-07:00
PERSON_ALERT_HOURS=always

TZ=Europe/London
